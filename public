<style>
:root{--bg:#020913;--side:#031321;--panel:#061a2c;--line:#0d5b8d;--blue:#168cff;--red:#ff123b;--green:#16c7ff;--muted:#91a8bc}*{box-sizing:border-box}body{margin:0;background:linear-gradient(rgba(1,7,14,.82),rgba(1,7,14,.94)),url('tbass-cinema-bg.svg') center/cover fixed,linear-gradient(135deg,#01070e,#031728 65%,#020912);color:#f7fbff;font-family:Inter,Arial,sans-serif;min-height:100vh}.top{height:66px;background:#010a14eF;border-bottom:1px solid #123852;display:flex;align-items:center;padding:0 18px;gap:20px;position:sticky;top:0;z-index:5}.brand{font-weight:900;font-size:24px}.brand span{color:var(--red)}.sub{font-size:11px;color:#aab9c8}.topspace{flex:1}.icon{font-size:20px;color:#cfe2f1}.layout{display:grid;grid-template-columns:245px 1fr;min-height:calc(100vh - 66px)}aside{background:rgba(2,14,25,.9);border-right:1px solid #103b59;padding:18px}.navitem{padding:12px 13px;margin:4px 0;border-radius:9px;color:#d8e7f2;font-size:13px}.navitem.active{background:linear-gradient(90deg,#ff123b,#e60035);font-weight:800}.admin{border-top:1px solid #18384e;margin-top:18px;padding-top:18px;color:#c7d7e5}.main{padding:20px;max-width:1400px;width:100%;margin:auto}.login{position:fixed;inset:0;z-index:9999;display:flex;flex-direction:column;justify-content:center;max-width:420px;width:calc(100% - 32px);height:max-content;margin:auto;background:#061a2c;border:1px solid var(--line);border-radius:16px;padding:25px;box-shadow:0 20px 80px #000c}.hide{display:none}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.stat{background:linear-gradient(145deg,#08223a,#041525);border:1px solid #0b5c8e;border-radius:13px;padding:15px}.stat b{font-size:28px;display:block;margin-top:8px}.up{color:#16c7ff;font-size:12px}.panel{margin-top:16px;background:linear-gradient(145deg,#061b2e,#031321);border:1px solid #0b5c8e;border-radius:15px;padding:16px}.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.row .grow{flex:1}input{padding:11px;border-radius:9px;border:1px solid #1b5d85;background:#03111e;color:#fff}.item{border:1px solid #174d70;border-radius:12px;padding:14px;margin:10px 0;background:#041525}.pill{font-size:11px;border-radius:14px;padding:5px 8px;background:#213243}.pending{background:#5a3f12}.verified{background:#07558a}.activep{background:#07558a}.actions{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px}.actions button{padding:10px;border-radius:8px;border:1px solid #2b5872;background:#09223a;color:#fff;cursor:pointer}.actions button:nth-child(2){background:#087cf0;border-color:#16c7ff}.actions button:nth-child(3){background:#b9072e;border-color:#ff1745}.proof{max-width:170px;max-height:170px;border-radius:9px;margin-top:8px;border:1px solid #2d668c}button.loginbtn{width:100%;padding:13px;border:0;border-radius:9px;background:#168cff;color:#fff;font-weight:800;cursor:pointer}.muted{color:var(--muted);font-size:12px}
@media(max-width:850px){.layout{grid-template-columns:1fr}aside{display:none}.cards{grid-template-columns:1fr 1fr}.actions{grid-template-columns:1fr}.main{padding:14px}.top{height:60px}}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.72);backdrop-filter:blur(5px);display:grid;place-items:center;padding:20px;z-index:20}.modal.hide{display:none}.modalbox{width:min(1000px,100%);max-height:90vh;overflow:auto;background:linear-gradient(145deg,#061d31,#020d19);border:1px solid #0d6b9e;border-radius:16px;box-shadow:0 30px 90px #000}.modalhead{padding:15px 18px;border-bottom:1px solid #164664;display:flex;justify-content:space-between}.modalhead button{background:none;border:0;color:white;font-size:18px;cursor:pointer}.detailgrid{display:grid;grid-template-columns:1fr 1fr;gap:14px;padding:18px}.detailcard{border:1px solid #174d70;border-radius:12px;padding:15px;background:#041525}.bigaction{width:100%;padding:13px;border-radius:9px;border:0;color:white;font-weight:900;cursor:pointer;margin-top:8px}.green{background:#087cf0}.red{background:#d80738}.blue{background:#087cf0}@media(max-width:700px){.detailgrid{grid-template-columns:1fr}}

.sectioncards{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.sectioncard{border:1px solid #174d70;border-radius:12px;padding:15px;background:#041525}.sectioncard b{font-size:24px}.sectioncard .small{color:#91a8bc;font-size:12px}.actionlink{margin-top:10px;padding:10px;border-radius:8px;border:1px solid #206487;background:#07243a;color:#fff;cursor:pointer;width:100%}@media(max-width:800px){.sectioncards{grid-template-columns:1fr}}

/* V25 — mobile-first dashboard polish */
@media(max-width:850px){
  html{scroll-behavior:smooth} body{background-attachment:scroll}
  .top{padding:0 12px;gap:10px;height:60px;position:sticky}
  .brand{font-size:20px;line-height:1.05}.sub{font-size:10px}
  .top .icon{font-size:17px}.top #logout{font-size:12px;padding:9px 10px!important;white-space:nowrap}
  .layout{display:flex;flex-direction:column;min-height:calc(100vh - 60px)}
  aside{display:flex;flex-direction:row;gap:6px;overflow-x:auto;overscroll-behavior-x:contain;scrollbar-width:thin;padding:8px 10px;background:#020e1af5;border-right:0;border-bottom:1px solid #103b59;position:sticky;top:60px;z-index:4;-webkit-overflow-scrolling:touch}
  .navitem{flex:0 0 auto;white-space:nowrap;padding:11px 13px;margin:0;font-size:13px;min-height:42px;display:flex;align-items:center;cursor:pointer}
  .admin{display:none}
  .main{padding:12px;width:100%;min-width:0}
  .main h1{font-size:24px;line-height:1.2;margin:10px 0}
  .cards{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
  .stat{padding:12px;min-width:0}.stat b{font-size:clamp(20px,5vw,27px);overflow-wrap:anywhere}
  .panel{padding:12px;border-radius:12px;min-width:0}
  .row{align-items:stretch}.row input,.row select,.row button{max-width:100%;min-width:0}
  input,select,textarea{font-size:16px;max-width:100%;min-height:42px}
  button,.actionlink,.actions button,.bigaction{min-height:44px;touch-action:manipulation}
  .actions{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
  .actions button{padding:10px 8px;overflow-wrap:anywhere}
  .item{padding:12px;overflow-wrap:anywhere}.proof{max-width:min(100%,220px);height:auto}
  .sectioncards{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.sectioncard{padding:12px;min-width:0}.sectioncard b{font-size:22px}
  .login{margin:28px auto;padding:20px;width:100%}
  .modal{padding:8px;align-items:end}.modalbox{max-height:92dvh;border-radius:16px 16px 8px 8px}.detailgrid{padding:12px;gap:10px}
  table{display:block;max-width:100%;overflow-x:auto;white-space:nowrap}
}
