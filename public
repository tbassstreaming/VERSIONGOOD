</style></head><body>
<header class="top"><div class="brand">▶ T-<span>BASS</span><div class="sub">Dashboard Admin</div></div><div class="topspace"></div><div class="icon">♧</div><div class="icon">🔔</div><div class="icon">⚙</div><button id="logout" style="padding:8px 12px;background:#061b2c;border:1px solid #205477;color:white;border-radius:8px">Déconnexion</button></header>
<div class="layout"><aside><div class="navitem active" onclick="showSection('dashboard',this)">⌂ &nbsp; Tableau de bord</div><div class="navitem" onclick="showSection('requests',this)">♙ &nbsp; Nouvelles demandes</div><div class="navitem" onclick="showSection('clients',this)">♙ &nbsp; Clients</div><div class="navitem" onclick="showSection('payments',this)">▣ &nbsp; Paiements</div><div class="navitem" onclick="showSection('subscriptions',this)">▣ &nbsp; Abonnements</div><div class="navitem" onclick="showSection('activations',this)">⚙ &nbsp; Activations</div><div class="navitem" onclick="showSection('groups',this)">☁ &nbsp; Groupes WhatsApp</div><div class="navitem" onclick="showSection('whatsapp',this)">♧ &nbsp; WhatsApp Privé</div><div class="navitem" onclick="showSection('notifications',this)">♧ &nbsp; Notifications</div><div class="navitem" onclick="showSection('reports',this)">▥ &nbsp; Rapports</div><div class="navitem" onclick="showSection('settings',this)">⚙ &nbsp; Paramètres</div><div class="admin">👤 Admin T-BASS<br><span class="muted">Super Administrateur</span></div></aside>
<main class="main"><div id="login" class="login"><h2>Dashboard privé</h2><p class="muted">Connexion sécurisée de démonstration.</p><input id="u" placeholder="Username" style="width:100%"><br><br><input id="p" type="password" placeholder="Password" style="width:100%"><br><br><button class="loginbtn" onclick="login()">Se connecter</button><p id="lm"></p></div>
<div id="app" class="hide"><h1>Tableau de bord</h1><div class="cards"><div class="stat">Nouvelles demandes<b id="pending">0</b><span class="up">↑ à traiter</span></div><div class="stat">Clients actifs<b id="active">0</b><span class="up">↑ en service</span></div><div class="stat">Revenus (ce mois)<b id="revenue">0 HTG</b><span class="up">↑ activations</span></div><div class="stat">Paiements vérifiés<b id="payments">0</b><span class="up">↑ contrôlés</span></div></div>
<div id="sectionTitle" style="margin:18px 0 8px;color:#9edcff;font-weight:800">Vue générale</div>
<div id="workspace" class="panel" style="margin-top:10px">
  <div id="workspaceContent"></div>
</div>
<section class="panel"><div class="row"><h2 class="grow">Nouvelles demandes d'inscription</h2><input id="search" oninput="render()" placeholder="Rechercher un client..."><button onclick="exportCSV()" style="padding:11px;border-radius:9px;border:1px solid #197f9f;background:#071b2b;color:#8edfff;font-weight:800;cursor:pointer">⇩ Exporter</button></div><div id="list"></div></section></div></main></div><div id="modal" class="modal hide"><div class="modalbox"><div class="modalhead"><b>← Détail de la demande</b><button onclick="closeModal()">✕</button></div><div id="detail"></div></div></div></main></div>
<script>
let data=[];
async function changeAdminPassword(){
 const current=document.getElementById('currentAdminPassword').value;
 const next=document.getElementById('newAdminPassword').value;
 const confirm=document.getElementById('confirmAdminPassword').value;
 const msg=document.getElementById('passwordMsg');
 if(next!==confirm){msg.textContent='Nouvo modpas yo pa menm.';return;}
 if(next.length<12 || !/[A-Za-z]/.test(next) || !/[0-9]/.test(next)){msg.textContent='Mete omwen 12 karaktè, ak lèt ak chif.';return;}
 const r=await fetch('/api/admin/change-password',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({currentPassword:current,newPassword:next})});
 const d=await r.json(); msg.textContent=d.message||d.error||'Gen yon erè.';
 if(r.ok){document.getElementById('currentAdminPassword').value='';document.getElementById('newAdminPassword').value='';document.getElementById('confirmAdminPassword').value='';}
}
async function login(){const username=document.getElementById('u').value.trim();const password=document.getElementById('p').value;const msg=document.getElementById('lm');msg.textContent='';const r=await fetch('/api/admin/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username,password})});const d=await r.json();if(d.ok){document.getElementById('login').classList.add('hide');document.getElementById('app').classList.remove('hide');await load()}else msg.textContent=d.error||'Non konekte. Verifye enfòmasyon yo.'}
async function load(){const me=await fetch('/api/admin/me');if(!me.ok)return;const [s,c]=await Promise.all([fetch('/api/admin/stats'),fetch('/api/admin/customers')]);const st=await s.json();data=await c.json();pending.textContent=st.pending;active.textContent=st.active;payments.textContent=st.payments;revenue.textContent=st.revenue.toLocaleString()+' HTG';render()}
function render(){const q=search.value.toLowerCase();list.innerHTML=data.filter(x=>(x.name+x.phone+x.status+x.plan+x.payment_method).toLowerCase().includes(q)).map(x=>`<article class="item"><div class="row"><b>${esc(x.name)}</b><span class="pill">${x.status}</span><span class="pill ${x.payment_status==='VERIFIED'?'verified':'pending'}">${x.payment_status}</span></div><p>📱 ${esc(x.phone)} &nbsp; • &nbsp; Plan ${x.plan} HTG/mois</p><p>💳 ${esc(x.payment_method)}</p><p class="muted">Demande: ${new Date(x.submitted_at).toLocaleString()}</p><img class="proof" src="/api/admin/customers/${x.id}/proof" alt="Preuve de paiement"><div class="actions"><button onclick="openDetail(${x.id})">👁 Voir détail</button><button onclick="verify(${x.id})">✓ Vérifier paiement</button><button onclick="activate(${x.id})">✓ ACTIVER LE CLIENT</button><button onclick="rejectC(${x.id})">✕ REFUSER</button><button onclick="openWhatsApp(${x.id},x.status==='ACTIVE'?'active':'welcome')">WhatsApp</button></div></article>`).join('')||'<p class="muted">Aucune demande.</p>'}
function openWhatsApp(id,kind='welcome'){
 const x=data.find(v=>v.id===id); if(!x)return;
 let phone=String(x.phone||'').replace(/[^0-9]/g,'');
 if(phone.startsWith('0')) phone='509'+phone.slice(1);
 if(phone.length===8) phone='509'+phone;
 if(!phone){alert('Nimewo kliyan an pa disponib.');return;}
 let message;
 if(kind==='active' || x.status==='ACTIVE') message=`Bonsoir ${x.name}, bienvenue chez T-BASS Streaming ! Votre abonnement au plan ${x.plan} HTG est activé. Merci de votre confiance. Pour toute question, répondez à ce message.`;
 else message=`Bonsoir ${x.name}, merci d’avoir choisi T-BASS Streaming. Nous avons reçu votre demande pour le plan ${x.plan} HTG. Votre paiement sera vérifié avant l’activation. Nous vous tiendrons informé(e).`;
 window.open('https://wa.me/'+phone+'?text='+encodeURIComponent(message),'_blank','noopener');
}
async function act(url){const r=await fetch(url,{method:'POST'});const d=await r.json();if(!d.ok)alert(d.error||'Erreur');load()}
const verify=id=>act('/api/admin/customers/'+id+'/verify-payment');const activate=id=>act('/api/admin/customers/'+id+'/activate');const rejectC=id=>act('/api/admin/customers/'+id+'/reject');
async function renewSubscription(id){if(!confirm('Ou verifye peman renouvèlman kliyan sa a deja?'))return;const r=await fetch('/api/admin/customers/'+id+'/renew',{method:'POST'});const x=await r.json();if(!r.ok){alert(x.error||'Erè');return;}alert(x.message||'Abònman renouvle.');await load();showSection('subscriptions',document.querySelectorAll('aside .navitem')[4]);}
async function expireSubscription(id){if(!confirm('Make abònman sa a kòm ekspire?'))return;const r=await fetch('/api/admin/customers/'+id+'/expire',{method:'POST'});const x=await r.json();if(!r.ok){alert(x.error||'Erè');return;}alert(x.message||'Abònman mete kòm ekspire.');await load();showSection('subscriptions',document.querySelectorAll('aside .navitem')[4]);}


function openDetail(id){
 const x=data.find(v=>v.id===id); if(!x)return;
 detail.innerHTML=`<div class="detailgrid">
 <div class="detailcard"><h3>${esc(x.name)}</h3><p>📱 ${esc(x.phone)}</p><p>🟡 Statut: ${esc(x.status)}</p><img class="proof" src="/api/admin/customers/${x.id}/proof"></div>
 <div class="detailcard"><h3>Informations d'abonnement</h3><p>Plan: <b>${x.plan} HTG / mois</b></p><p>Paiement: ${esc(x.payment_method)}</p><p>Vérification: ${esc(x.payment_status)}</p></div>
 <div class="detailcard"><h3>Actions</h3><button class="bigaction green" onclick="activate(${x.id});closeModal()">✓ Activer le client</button><button class="bigaction blue" onclick="verify(${x.id})">✓ Vérifier le paiement</button><button class="bigaction red" onclick="rejectC(${x.id});closeModal()">✕ Refuser la demande</button></div>
 <div class="detailcard"><h3>Historique</h3><p class="muted">Demande reçue: ${new Date(x.submitted_at).toLocaleString()}</p><p class="muted">Activation: ${x.activated_at?new Date(x.activated_at).toLocaleString():'En attente'}</p></div>
 </div>`;
 modal.classList.remove('hide');
}
function closeModal(){modal.classList.add('hide')}



function setActive(el){document.querySelectorAll('aside .navitem').forEach(x=>x.classList.remove('active'));if(el)el.classList.add('active')}
function showSection(name,el){
 setActive(el);
 const titles={dashboard:'Vue générale',requests:'Nouvelles demandes',clients:'Clients',payments:'Paiements',subscriptions:'Abonnements',activations:'Activations',groups:'Groupes WhatsApp',whatsapp:'WhatsApp Privé',notifications:'Notifications',reports:'Rapports',settings:'Paramètres'};
 sectionTitle.textContent=titles[name]||'T-BASS';
 const active=data.filter(x=>x.status==='ACTIVE'), pendingRows=data.filter(x=>x.status==='PENDING'), verified=data.filter(x=>x.payment_status==='VERIFIED');
 let html='';
 if(name==='dashboard') html=`<div class="sectioncards">
 <div class="sectioncard">👥<div class="small">Clients actifs</div><b>${active.length}</b></div>
 <div class="sectioncard">🧾<div class="small">Demandes en attente</div><b>${pendingRows.length}</b></div>
 <div class="sectioncard">💰<div class="small">Paiements vérifiés</div><b>${verified.length}</b></div></div>`;
 if(name==='requests') html=`<h3>Demandes à traiter</h3><p class="muted">${pendingRows.length} demande(s) attendent une vérification.</p><button class="actionlink" onclick="focusPending()">Afficher les demandes</button>`;
 if(name==='clients') html=`<h3>Base clients</h3><p class="muted">${data.length} client(s) enregistré(s).</p><button class="actionlink" onclick="document.getElementById('search').focus()">Rechercher un client</button>`;
 if(name==='payments') html=`<h3>Paiements</h3><div class="sectioncards"><div class="sectioncard">⏳<div class="small">À vérifier</div><b>${data.filter(x=>x.payment_status==='PENDING').length}</b></div><div class="sectioncard">✓<div class="small">Vérifiés</div><b>${verified.length}</b></div></div>`;
 if(name==='subscriptions') { const expired=data.filter(x=>x.status==='EXPIRED'); const ending=data.filter(x=>x.status==='ACTIVE'&&x.subscription_end&&((new Date(x.subscription_end)-Date.now())/86400000)<=7); html=`<h3>Gestion des abonnements</h3><div class="sectioncards"><div class="sectioncard">🔵<div class="small">Actifs</div><b>${active.length}</b></div><div class="sectioncard">⏰<div class="small">Expire bientôt (7 jours)</div><b>${ending.length}</b></div><div class="sectioncard">⌛<div class="small">Expirés</div><b>${expired.length}</b></div><div class="sectioncard">📅<div class="small">Durée standard</div><b>30 jours</b></div></div><p class="muted">Renouvèlman mande verifikasyon peman an anvan.</p><div class="subscriptionlist">${data.filter(x=>['ACTIVE','EXPIRED'].includes(x.status)).map(x=>`<article class="item"><div class="row"><b>${esc(x.name)}</b><span class="pill">${esc(x.status)}</span></div><p>📱 ${esc(x.phone)} • Plan ${esc(x.plan)} HTG / mwa</p><p class="muted">Kòmanse: ${x.subscription_start?new Date(x.subscription_start).toLocaleDateString():'—'} • Ekspire: ${x.subscription_end?new Date(x.subscription_end).toLocaleDateString():'—'}</p><p class="muted">Peman: ${esc(x.payment_status)}</p><div class="actions"><button onclick="verify(${x.id})">✓ Verifye peman</button><button onclick="renewSubscription(${x.id})">↻ Renouvle 30 jou</button><button onclick="expireSubscription(${x.id})">Make ekspire</button></div></article>`).join('')||'<p class="muted">Pa gen abònman aktif oswa ekspire ankò.</p>'}</div>`; }
 if(name==='activations') html=`<h3>Activations</h3><p class="muted">Les clients sont activés manuellement après vérification du paiement.</p><button class="actionlink" onclick="showSection('requests',document.querySelectorAll('aside .navitem')[1])">Traiter les demandes</button>`;
 if(name==='groups') html=`<h3>Groupes WhatsApp</h3><p class="muted">Le lien est enregistré côté serveur.</p><input id="groupLink" placeholder="https://chat.whatsapp.com/..." style="width:100%;padding:11px;border-radius:9px;border:1px solid #1b5d85;background:#03111e;color:#fff"><button class="actionlink" onclick="saveSettings()">Enregistrer le lien</button><p id="groupMsg" class="muted"></p>`;
