function reportRows(){
 const period=document.getElementById('reportPeriod')?.value||'month';
 const now=new Date(); const start=new Date(now); start.setHours(0,0,0,0);
 if(period==='month') start.setDate(1); else if(period==='30') start.setDate(start.getDate()-29); else if(period==='7') start.setDate(start.getDate()-6); else return data.slice();
 return data.filter(x=>{const d=new Date(x.submitted_at);return !Number.isNaN(d.getTime())&&d>=start&&d<=now;});
}
function renderReports(){
 const root=document.getElementById('reportContent'); if(!root)return;
 const rows=reportRows(), activeRows=rows.filter(x=>x.status==='ACTIVE'), pendingRows=rows.filter(x=>x.status==='PENDING'), expiredRows=rows.filter(x=>x.status==='EXPIRED'), verifiedRows=rows.filter(x=>x.payment_status==='VERIFIED');
 const revenue=verifiedRows.reduce((sum,x)=>sum+(Number(x.amount_htg)||0),0);
 const plans={}; rows.forEach(x=>{const k=String(x.plan||'Autre');plans[k]=(plans[k]||0)+1;});
 const months=[]; const now=new Date(); for(let i=5;i>=0;i--){const d=new Date(now.getFullYear(),now.getMonth()-i,1);months.push({key:d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0'),label:d.toLocaleDateString('fr-FR',{month:'short'}),count:0});}
 data.forEach(x=>{const d=new Date(x.submitted_at);if(Number.isNaN(d.getTime()))return;const m=months.find(y=>y.key===d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0'));if(m)m.count++;});
 const max=Math.max(1,...months.map(m=>m.count));
 const bars=months.map(m=>`<div style="flex:1;min-width:25px;text-align:center"><div title="${m.count} demande(s)" style="height:${Math.max(4,m.count/max*120)}px;background:linear-gradient(180deg,#16c7ff,#087cf0);border-radius:6px 6px 0 0;margin:0 auto;width:min(34px,80%)"></div><div class="muted" style="margin-top:6px">${esc(m.label)}</div><b style="font-size:12px">${m.count}</b></div>`).join('');
 root.innerHTML=`<div class="sectioncards"><div class="sectioncard"><div class="small">Demandes enregistrées</div><b>${rows.length}</b></div><div class="sectioncard"><div class="small">Clients actifs</div><b>${activeRows.length}</b></div><div class="sectioncard"><div class="small">Paiements vérifiés</div><b>${verifiedRows.length}</b></div><div class="sectioncard"><div class="small">Revenus vérifiés (HTG)</div><b>${revenue.toLocaleString('fr-FR')}</b></div></div>
 <div class="panel"><h3>Demandes sur les 6 derniers mois</h3><div style="display:flex;align-items:end;gap:12px;min-height:165px;padding:12px 4px 0;border-bottom:1px solid #174d70">${bars}</div><p class="muted">Le graphique compte les demandes par date de soumission, indépendamment de leur statut actuel.</p></div>
 <div class="sectioncards" style="margin-top:12px"><div class="sectioncard"><div class="small">En attente</div><b>${pendingRows.length}</b></div><div class="sectioncard"><div class="small">Expirés</div><b>${expiredRows.length}</b></div><div class="sectioncard"><div class="small">Taux d’activation</div><b>${rows.length?Math.round(activeRows.length/rows.length*100):0}%</b></div></div>
 <div class="panel"><h3>Répartition par plan</h3>${Object.keys(plans).length?Object.entries(plans).sort((a,b)=>b[1]-a[1]).map(([k,v])=>`<div style="margin:10px 0"><div class="row"><span class="grow">Plan ${esc(k)}</span><b>${v}</b></div><div style="height:8px;background:#102b40;border-radius:6px;overflow:hidden"><div style="height:100%;width:${Math.round(v/Math.max(1,rows.length)*100)}%;background:#168cff"></div></div></div>`).join(''):'<p class="muted">Aucune donnée pour cette période.</p>'}</div>`;
}
function exportReportCSV(){
 const rows=reportRows(); const summary=[['Indicateur','Valeur'],['Demandes',rows.length],['Clients actifs',rows.filter(x=>x.status==='ACTIVE').length],['En attente',rows.filter(x=>x.status==='PENDING').length],['Paiements vérifiés',rows.filter(x=>x.payment_status==='VERIFIED').length],['Revenus vérifiés HTG',rows.filter(x=>x.payment_status==='VERIFIED').reduce((n,x)=>n+(Number(x.amount_htg)||0),0)],[],['ID','Nom','Téléphone','Plan','Montant HTG','Méthode','Statut client','Statut paiement','Soumis le']];
 rows.forEach(x=>summary.push([x.id,x.name,x.phone,x.plan,x.amount_htg,x.payment_method,x.status,x.payment_status,x.submitted_at]));
 const csv=summary.map(r=>r.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(',')).join('\n'); const a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}));a.download='tbass-rapport-statistiques.csv';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);
}

async function saveSettings(){
 const body={};
 if(document.getElementById('groupLink')) body.whatsapp_group=document.getElementById('groupLink').value;
 if(document.getElementById('waNumber')) body.whatsapp_private=document.getElementById('waNumber').value;
 const r=await fetch('/api/admin/settings',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
 const x=await r.json(); const el=document.getElementById(body.whatsapp_group!==undefined?'groupMsg':'waMsg'); if(el)el.textContent=x.ok?'Enregistré avec succès.':'Erreur';
}
async function loadSettings(){
 const r=await fetch('/api/admin/settings'); if(!r.ok)return; const x=await r.json();
 if(document.getElementById('groupLink'))document.getElementById('groupLink').value=x.whatsapp_group||'';
 if(document.getElementById('waNumber'))document.getElementById('waNumber').value=x.whatsapp_private||'';
}
async function loadAudit(){
 const r=await fetch('/api/admin/audit'); if(!r.ok)return; const rows=await r.json();
 auditBox.innerHTML=rows.map(x=>`<div class="sectioncard" style="margin:7px 0"><b>${esc(x.action)}</b><div class="small">${esc(x.customer_name||'Système')} • ${new Date(x.created_at).toLocaleString()}</div></div>`).join('')||'<p class="muted">Aucun historique.</p>';
}

function saveLocal(key,msg){localStorage.setItem('tbass_'+key,document.getElementById(key).value);document.getElementById(key.replace('Link','Msg').replace('Number','Msg')).textContent=msg}

function focusPending(){document.querySelector('.panel').scrollIntoView({behavior:'smooth'});search.value='PENDING';render()}
function exportCSV(){
 const rows=[['ID','Nom','Téléphone','Plan','Méthode de paiement','Statut','Statut paiement','Date']];
 data.forEach(x=>rows.push([x.id,x.name,x.phone,x.plan,x.payment_method,x.status,x.payment_status,x.submitted_at]));
 const csv=rows.map(r=>r.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(',')).join('\n');
 const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));a.download='tbass-clients.csv';a.click();URL.revokeObjectURL(a.href);
